{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domain-agent-framework.dev/protocol/enterprise/signed-authorization-v1.schema.json",
  "title": "Signed Authorization v1",
  "type": "object",
  "required": ["claims", "signature"],
  "properties": {
    "claims": {
      "type": "object",
      "required": ["version", "authorization_id", "issuer", "key_id", "audience", "issued_at", "expires_at", "action_id", "decision_id", "action_type", "entity_id", "entity_type", "parameters_sha256", "preconditions_sha256"],
      "properties": {
        "version": {"const": 1},
        "authorization_id": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "issued_at": {"type": "integer"},
        "expires_at": {"type": "integer"},
        "action_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "action_type": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "entity_type": {"type": "string", "minLength": 1},
        "parameters_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "preconditions_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "idempotency_key": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "signature": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
